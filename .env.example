# Arbitrum One WebSocket RPC; use a provider with historical eth_call and logs.
RPC_WS_URL=wss://your-arbitrum-rpc.example/ws

# PostgreSQL and Redis are projections/state stores. Use separate instances per deployment.
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=15432
REDIS_PORT=16379
DATABASE_URL=postgres://searcher:local-only-change-me@localhost:15432/searcher
REDIS_URL=redis://localhost:16379

# Address used only as `from` in eth_call / eth_estimateGas. No key is loaded.
# A realistic executor may need token balances and approvals for the simulation to pass.
SIMULATION_CALLER=0x000000000000000000000000000000000000dEaD

RUST_LOG=info
